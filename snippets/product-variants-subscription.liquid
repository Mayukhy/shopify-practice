{% comment %}
  Renders product subscription variants with single and double subscription options

  Accepts:
  - product: product object (required) - The main product containing subscription metafields
  - block: section block object (optional) - For accessing block settings and shopify_attributes

  Usage:
  {% render 'product-variants-subscription', product: product, block: block %}

  Expects:
  - product.metafields.custom.single_subcription.value: single subscription metafield data
  - product.metafields.custom.double_subcription.value: double subscription metafield data
  - variant-subcriptions.js: JavaScript file for handling subscription interactions

  Metafield Structure:
  - single_subcription.flaver.value: array of product variants for single subscription
  - double_subcription.flaver1.value: array of product variants for double subscription flavor 1
  - double_subcription.flaver2.value: array of product variants for double subscription flavor 2
  - what_s_included.value.single_variant_image: image for single variant display
  - what_s_included.value.all_variant_images.value: array of images for multiple variants
  - instructions.value: instruction content for subscription type
{% endcomment %}

{% liquid
  comment
    Assign subscription metafield data to variables for easier access throughout template
  endcomment
  assign one_subscription_metafield = product.metafields.custom.single_subcription.value
  assign two_subscription_metafield = product.metafields.custom.double_subcription.value
  assign one_subscription_single_image = one_subscription_metafield.what_s_included.value.single_variant_image
  assign two_subscription_single_image = two_subscription_metafield.what_s_included.value.single_variant_image
  assign one_subscription_multi_images = one_subscription_metafield.what_s_included.value.all_variant_images.value
  assign two_subscription_multi_images = two_subscription_metafield.what_s_included.value.all_variant_images.value
  assign one_subscription_instructions = one_subscription_metafield.instructions.value
  assign two_subscription_instructions = two_subscription_metafield.instructions.value
%}

{% comment %} Load subscription JavaScript for interactive functionality {% endcomment %}
<script src="{{ 'variant-subcriptions.js' | asset_url }}" defer="defer"></script>

{% comment %} Only render subscription options if both single and double subscription metafields are populated {% endcomment %}
{% if one_subscription_metafield != blank and two_subscription_metafield != blank %}
  <div class="subscription-options" {{ block.shopify_attributes }}>
    <div class="subscription-container">
      <div class="recommended-banner">Recommended</div>

      {% comment %}
        Custom element wrapper for subscription functionality
        Handles variant selection, price updates, and media gallery integration
      {% endcomment %}
      <variant-subcriptions>
        {% comment %} === SINGLE SUBSCRIPTION OPTION === {% endcomment %}
        <details
          class="subscription-option subscription-accordion"
          data-subscription="single"
          open
        >
          <summary>
            <div class="subscription-header">
              <label class="subscription-option-label">
                <input type="radio" name="subscription-type" value="single" class="subscription-radio" checked>
                <span class="radio-custom"></span>
                <span class="subscription-name">Single Drink Subscription</span>
              </label>
              <div class="subscription-pricing">
                {% comment %} Default pricing - will be updated by JavaScript based on variant selection {% endcomment %}
                <span class="current-price">{{ product.price | money }}</span>
                <span class="original-price">{{ product.compare_at_price | money }}</span>
              </div>
            </div>
          </summary>
          <div class="accordion__content subscription-content active">
            {% comment %} Render flavor selection grid if single subscription flavors are available {% endcomment %}
            {% comment %}
              Flavor Selection Grid
              - Renders radio buttons for each flavor variant
              - Displays product variant images using Shopify's image_tag filter
              - Auto-selects first flavor option with "BEST-SELLER" tag
              - Each radio input contains JSON data for JavaScript processing
            {% endcomment %}
            {% if one_subscription_metafield.flaver != blank %}
              <div class="flavor-section">
                <h4 class="section-title">Choose Flavor</h4>
                <div class="flavor-grid">
                  {% comment %}Loop through flavor variants from metafield{% endcomment %}
                  {% for product_variant in one_subscription_metafield.flaver.value %}
                    <div class="flavor-option">
                      {% comment %}Mark first flavor as best seller{% endcomment %}
                      {% if forloop.first %}
                        <span class="best-seller-tag">BEST-SELLER</span>
                      {% endif %}
                      {% comment %}Radio input with variant JSON data for JavaScript{% endcomment %}
                      <input
                        type="radio"
                        id="single-flavor-{{ forloop.index }}"
                        name="single-flavor"
                        value="{{ product_variant | json }}"
                        {% if forloop.first %}
                          checked
                        {% endif %}
                        class="flavor-radio"
                      >
                      <label for="single-flavor-{{ forloop.index }}" class="flavor-label">
                        <div class="flavor-header">
                          <span class="flavor-name">{{ product_variant.title }}</span>
                        </div>
                        <div class="flavor-image">
                          {{
                            product_variant.featured_image
                            | image_url: width: 80, height: 80
                            | image_tag: loading: 'lazy', width: 80, height: 80, alt: product_variant.title
                          }}
                        </div>
                      </label>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            <div class="delivery-section">
              <h4 class="section-title">What's Included</h4>
              <div class="delivery-options">
                <div class="delivery-option">
                  <input
                    type="radio"
                    id="delivery-30days"
                    name="delivery-frequency"
                    value="30days"
                    class="delivery-radio"
                  >
                  <label for="delivery-30days" class="delivery-label">
                    <span class="delivery-text">Every 30 Days</span>
                    <div class="delivery-image">
                      <div class="single-bottle">
                        {{
                          one_subscription_single_image
                          | image_url: width: 58, height: 140
                          | image_tag: loading: 'lazy', width: 58, height: 140, alt: 'Single subscription bottle'
                        }}
                      </div>
                    </div>
                  </label>
                </div>
                <div class="delivery-option">
                  <input
                    type="radio"
                    id="delivery-onetime"
                    name="delivery-frequency"
                    value="onetime"
                    class="delivery-radio"
                    checked
                  >
                  <label for="delivery-onetime" class="delivery-label">
                    <span class="delivery-text">One Time <span class="free-text">(Free)</span></span>
                    <div class="delivery-image">
                      <div class="triple-bottles">
                        {% for item in one_subscription_multi_images %}
                          {{
                            item
                            | image_url: width: 58, height: 140
                            | image_tag: loading: 'lazy', width: 58, height: 140, alt: 'Double subscription bottle'
                          }}
                        {% endfor %}
                      </div>
                    </div>
                  </label>
                </div>
              </div>
            </div>

            {% comment %}
              Benefits List Section
              - Displays subscription benefits from metafield instructions
              - Each benefit includes checkmark icon and descriptive text
              - Dynamically renders all available benefits
            {% endcomment %}
            <div class="benefits-section">
              <ul class="benefits-list">
                {% comment %}Loop through subscription benefits{% endcomment %}
                {% for item in one_subscription_instructions %}
                  <li class="benefit-item">
                    <span class="checkmark">
                      <svg width="13" height="9" viewBox="0 0 13 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.8161 0.408665C12.0826 0.64187 12.1068 1.04814 11.8698 1.31125L5.19648 8.71819C4.95818 8.98267 4.54903 8.99949 4.28984 8.75551L0.428237 5.12014C0.187415 4.89342 0.164363 4.51564 0.37098 4.25738C0.598968 3.97239 1.02353 3.93317 1.29486 4.17721L4.29095 6.87213C4.55132 7.10634 4.95218 7.0854 5.18676 6.82535L10.9268 0.461168C11.159 0.203628 11.5551 0.180283 11.8161 0.408665Z" fill="black"/>
                      </svg>
                    </span>
                    <span class="benefit-text">{{ item }}</span>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </details>

        {% comment %}
          Double Subscription Option
          - Second subscription accordion for dual flavor selection
          - Contains two separate flavor selection grids
          - Includes delivery options and benefits similar to single subscription
          - Uses same accordion structure with details/summary tags
        {% endcomment %}
        <!-- Double Subscription Option -->
        <details class="subscription-option subscription-accordion" data-subscription="double">
          <summary>
            <div class="subscription-header">
              <label class="subscription-option-label">
                <input type="radio" name="subscription-type" value="double" class="subscription-radio">
                <span class="radio-custom"></span>
                <span class="subscription-name">Double Drink Subscription</span>
              </label>
              <div class="subscription-pricing">
                <span class="current-price">{{ product.price | money }}</span>
                <span class="original-price">{{ product.compare_at_price | money }}</span>
              </div>
            </div>
          </summary>
          <div class="accordion__content subscription-content active">
            {% comment %}
              Dual Flavor Selection for Double Subscription
              - Two separate flavor grids for flavor1 and flavor2 metafields
              - Each flavor selection works independently
              - Both use same structure as single subscription flavors
            {% endcomment %}
            {% if two_subscription_metafield.flaver1 != blank and two_subscription_metafield.flaver2 != blank %}
              {% comment %}First flavor selection grid{% endcomment %}
              <div class="flavor-section">
                <h4 class="section-title">Choose Flavor 1</h4>
                <div class="flavor-grid">
                  {% for product_variant in two_subscription_metafield.flaver1.value %}
                    <div class="flavor-option">
                      {% if forloop.first %}
                        <span class="best-seller-tag">BEST-SELLER</span>
                      {% endif %}
                      <input
                        type="radio"
                        id="double-flavor1-{{ forloop.index }}"
                        name="double-flavor1"
                        value="{{ product_variant | json }}"
                        {% if forloop.first %}
                          checked
                        {% endif %}
                        class="flavor-radio"
                      >
                      <label for="double-flavor1-{{ forloop.index }}" class="flavor-label">
                        <div class="flavor-header">
                          <span class="flavor-name">{{ product_variant.title }}</span>
                        </div>
                        <div class="flavor-image">
                          {{
                            product_variant.featured_image
                            | image_url: width: 80, height: 80
                            | image_tag: loading: 'lazy', width: 80, height: 80, alt: product_variant.title
                          }}
                        </div>
                      </label>
                    </div>
                  {% endfor %}
                </div>
                <h4 class="section-title">Choose Flavor 2</h4>
                <div class="flavor-grid">
                  {% for product_variant in two_subscription_metafield.flaver2.value %}
                    <div class="flavor-option">
                      {% if forloop.first %}
                        <span class="best-seller-tag">BEST-SELLER</span>
                      {% endif %}
                      <input
                        type="radio"
                        id="double-flavor2-{{ forloop.index }}"
                        name="double-flavor2"
                        value="{{ product_variant | json }}"
                        {% if forloop.first %}
                          checked
                        {% endif %}
                        class="flavor-radio"
                      >
                      <label for="double-flavor2-{{ forloop.index }}" class="flavor-label">
                        <div class="flavor-header">
                          <span class="flavor-name">{{ product_variant.title }}</span>
                        </div>
                        <div class="flavor-image">
                          {{
                            product_variant.featured_image
                            | image_url: width: 80, height: 80
                            | image_tag: loading: 'lazy', width: 80, height: 80, alt: product_variant.title
                          }}
                        </div>
                      </label>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            <div class="delivery-section">
              <h4 class="section-title">What's Included</h4>
              <div class="delivery-options">
                <div class="delivery-option">
                  <input
                    type="radio"
                    id="delivery-30days"
                    name="delivery-frequency"
                    value="30days"
                    class="delivery-radio"
                  >
                  <label for="delivery-30days" class="delivery-label">
                    <span class="delivery-text">Every 30 Days</span>
                    <div class="delivery-image">
                      <div class="single-bottle">
                        {{
                          two_subscription_single_image
                          | image_url: width: 58, height: 140
                          | image_tag: loading: 'lazy', width: 58, height: 140, alt: 'Single subscription bottle'
                        }}
                      </div>
                    </div>
                  </label>
                </div>
                <div class="delivery-option">
                  <input
                    type="radio"
                    id="delivery-onetime"
                    name="delivery-frequency"
                    value="onetime"
                    class="delivery-radio"
                    checked
                  >
                  <label for="delivery-onetime" class="delivery-label">
                    <span class="delivery-text">One Time <span class="free-text">(Free)</span></span>
                    <div class="delivery-image">
                      <div class="triple-bottles">
                        {% for item in two_subscription_multi_images %}
                          {{
                            item
                            | image_url: width: 58, height: 140
                            | image_tag: loading: 'lazy', width: 58, height: 140, alt: 'Double subscription bottle'
                          }}
                        {% endfor %}
                      </div>
                    </div>
                  </label>
                </div>
              </div>
            </div>

            <div class="benefits-section">
              <ul class="benefits-list">
                {% for item in two_subscription_instructions %}
                  <li class="benefit-item">
                    <span class="checkmark">
                      <svg width="13" height="9" viewBox="0 0 13 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.8161 0.408665C12.0826 0.64187 12.1068 1.04814 11.8698 1.31125L5.19648 8.71819C4.95818 8.98267 4.54903 8.99949 4.28984 8.75551L0.428237 5.12014C0.187415 4.89342 0.164363 4.51564 0.37098 4.25738C0.598968 3.97239 1.02353 3.93317 1.29486 4.17721L4.29095 6.87213C4.55132 7.10634 4.95218 7.0854 5.18676 6.82535L10.9268 0.461168C11.159 0.203628 11.5551 0.180283 11.8161 0.408665Z" fill="black"/>
                      </svg>
                    </span>
                    <span class="benefit-text">{{ item }}</span>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </details>
      </variant-subcriptions>
    </div>
  </div>
  {% comment %}End of subscription options section{% endcomment %}
{% endif %}

{% comment %}
  Template Integration Notes:
  - Load variant-subscriptions.js for full functionality
  - Ensure CSS classes match component styling
  - Test accordion behavior with different metafield configurations
  - Validate image loading performance with lazy loading
{% endcomment %}
