{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<style>
  .custom-quick-add-modal__overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 99;
    width: 100vw;
    height: 100vh;
  }

  .custom-quick-add-modal__overlay.is-open {
    display: block;
  }

  .custom-quick-add-modal__main {
    box-sizing: border-box;
    opacity: 0;
    position: fixed;
    visibility: hidden;
    z-index: -1;
    margin: 0 auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 65vw;
    background: rgba(var(--color-foreground), 0.2);
    height: 80vh;
  }
  .custom-quick-add-modal__main.is-open {
    opacity: 1;
    visibility: visible;
    z-index: 101;
  }

  .custom-quick-add-modal__content {
    width: 100%;
    height: 100%;
    background: #fff;
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    overflow-y: auto;
  }

  .custom-quick-add-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .overflow-hidden {
    overflow: hidden;
  }
</style>

{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'customQuickAddModal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'customModalOpener.js' | asset_url }}" defer="defer"></script>

{%- assign section_id = section.id -%}
{%- assign section_id = section_id | remove: 'section-' -%}
{%- assign section_id = section_id | remove: 'index-' -%}
{%- assign section_id = section_id | remove: 'custom-' -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="custom-featured-products color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        class="grid grid--3-col product-grid grid--3-col-desktop grid--peek"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for product in section.settings.custom_product_list limit: 6 -%}
          <li
            class="grid__item slider__slide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
           {% render 'custom-card-product', card_product: product %}
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>
<div class="custom-quick-add-modal__overlay">

</div>

{% schema %}
{
  "name": "Custom Product list",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured Products",
      "label": "Section Title"
    },
    {
      "type": "product_list",
      "id": "custom_product_list",
      "label": "Product List"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Product List"
    }
  ]
}
{% endschema %}
